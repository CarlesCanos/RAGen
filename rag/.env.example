# Documents
# The UI manages this path per project. This default is used for the initial project.
DOCS_DIR=./docs
# Extensions discovered recursively inside the selected folder.
DOCS_EXTENSIONS=.md,.mdx,.markdown,.txt,.html,.htm,.pdf
# Fallback executable for PDFs that PDF.js cannot extract.
PDF_TO_TEXT_BIN=pdftotext
# Intermediate chunk manifest. The UI replaces this with a per-project path.
CHUNKS_PATH=output/chunks.json

# Ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_EMBED_MODEL=embeddinggemma
RAG_CHAT_MODEL=qwen3.5:4b-q4_K_M
OLLAMA_TEMPERATURE=0

# Chroma
CHROMA_COLLECTION=local_rag_docs
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_SSL=false

# Local optimized index. The UI replaces this with a per-project path.
RAG_INDEX_DIR=output/rag-v2
RAG_TOKENIZER_DIR=auto

# Model and retrieval budgets
RAG_CONTEXT=4096
RAG_TIMEOUT_MS=120000
RAG_KEEP_ALIVE=10m
RAG_CANDIDATES=20
RAG_RRF_K=60
RAG_CONTEXT_CHUNKS=4
RAG_NEIGHBORS=2
RAG_DIRECT_TOKENS=512
RAG_DEEP_TOKENS=1024
RAG_DECISION_TOKENS=256
RAG_VALIDATION_TOKENS=512
ASK_PREFERRED_LANGUAGE=English

# Chunking
SPLIT_TARGET_CHARS=1200
SPLIT_MAX_CHARS=1600
SPLIT_OVERLAP_CHARS=220

# Diagnostic logging. When enabled, document context and raw model output can appear
# in the console. Never enable it for sensitive documents or shared logs.
RAG_DEBUG=0
